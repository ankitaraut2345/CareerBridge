# ─── CareerBridge Environment Configuration Guide ─────────────────────────────
# CareerBridge is deployed as a fullstack application on Vercel with MongoDB Atlas.
# Configure these environment variables in your Vercel Project Settings (or local .env):

# ── 1. Backend / Serverless Functions (Required on Vercel) ──
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/careerbridge?retryWrites=true&w=majority
# JWT_SECRET=your_super_strong_random_jwt_secret_32_chars_min
# CLIENT_URL=https://your-careerbridge.vercel.app
# ENABLE_DEMO_LOGIN=false

# ── 2. Third-Party Integrations (Optional) ──
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# GEMINI_API_KEY=your_gemini_api_key

# ── 3. Frontend / Vite (Optional on Vercel) ──
# For unified Vercel deployment, VITE_API_URL defaults to /api automatically.
# Set VITE_API_URL only if your API is hosted on a separate custom domain.
# VITE_API_URL=https://your-careerbridge.vercel.app/api
# VITE_SOCKET_URL=  # Optional: only if using an external dedicated WebSocket server
