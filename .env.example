# ─── CareerBridge Root Environment Guide ──────────────────────────────────────
# CareerBridge is structured as a client/ and server/ full-stack application.
# Configure environment variables separately in client/.env and server/.env:

# ── 1. Backend (server/.env) ──
# NODE_ENV=production
# PORT=5000
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/careerbridge
# JWT_SECRET=your_super_strong_random_jwt_secret_32_chars_min
# CLIENT_URL=https://your-frontend.vercel.app
# CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# GEMINI_API_KEY=your_gemini_api_key

# ── 2. Frontend (client/.env or Vercel Environment Variables) ──
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-backend.onrender.com
