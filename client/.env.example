# ─── CareerBridge Frontend Environment Configuration ──────────────────────────
# Copy this file to .env or set these environment variables in Vercel / Netlify.
# All VITE_* variables are exposed to the client bundle. Never store server secrets here!

# Backend API Base URL (including /api suffix)
# Local: http://localhost:5000/api
# Production (Render/Railway): https://your-backend-app.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Optional: Dedicated Socket.IO Server URL (defaults automatically to VITE_API_URL without /api)
# Local: http://localhost:5000
# Production: https://your-backend-app.onrender.com
VITE_SOCKET_URL=http://localhost:5000
