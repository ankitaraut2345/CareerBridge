# ─── CareerBridge Server Environment Configuration ───────────────────────────
# Copy this file to .env and replace placeholders with your actual configuration.
# DO NOT COMMIT REAL .env FILES OR SECRETS TO VERSION CONTROL.

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# Server Port (Render / hosting services automatically set PORT)
PORT=5000

# MongoDB Connection String (MongoDB Atlas for Production, local URI for Development)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/careerbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/careerbridge

# JWT Authentication (Use a cryptographically random string of 32+ characters in production)
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Frontend Client Origin (Allowed CORS origin for web app & WebSockets)
# In production, set to your deployed Vercel domain (e.g., https://careerbridge.vercel.app)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (Required for Student Resume PDF Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# AI Resume Analysis & AI Interview Preparation (Google Gemini API)
# Fallback advisory heuristically operates if keys are omitted
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash

# Demo Accounts Seed Password (Used only by npm run seed in development/testing)
DEMO_ACCOUNTS_PASSWORD=CareerBridgeDemo@2026
